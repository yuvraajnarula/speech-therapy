# ==============================================================================
# Enterprise Speech Therapy Platform - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Speech Therapy MBP"
API_V1_STR=/api/v1
SECRET_KEY=enterprise-super-secret-key-change-in-production-min32bytes!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma-separated origin allow-list (NEVER use "*" in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration (PostgreSQL / SQLite fallback for local test)
DATABASE_URL=sqlite+aiosqlite:///./speech_therapy.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/speech_therapy

# Cloud Storage Configuration (AWS S3 / GCS / Local Encrypted)
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=speech-therapy-clinical-audio
S3_ENDPOINT_URL=

# HIPAA / Healthcare Compliance
ENABLE_HIPAA_LOG_REDACTION=true
ENCRYPT_AUDIO_AT_REST=true
DATASET_EXPORT_DIR=./dataset/anonymized_exports

# AI / AST Model Settings
DEFAULT_STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
ENABLE_INDIC_AST=true
DEFAULT_TARGET_LANGUAGE=en
DEFAULT_SOURCE_LANGUAGE=hi

# MLOps & Experiment Tracking
MLOPS_TRACKER=local
# MLOPS_TRACKER=wandb
WANDB_API_KEY=
WANDB_PROJECT=speech-therapy-ast
MLFLOW_TRACKING_URI=http://localhost:5000

# Async Worker Queue (Redis — Celery broker + clinical memory layer)
# Local dev falls back to in-memory memory layer if Redis is unreachable.
REDIS_URL=redis://localhost:6379/0

# Enterprise Identity Provider (OIDC / OAuth2 / JWKS)
# Comma-separated list of enabled providers (e.g. "auth0,azure")
OIDC_ENABLED_PROVIDERS=
# Per-provider config as JSON dicts, e.g. for Auth0:
#   "auth0" shown below; replace domain to match your tenant
# OIDC_JWKS_URLS={"auth0":"https://YOUR_TENANT.auth0.com/.well-known/jwks.json","azure":"https://login.microsoftonline.com/common/discovery/v2.0/keys"}
OIDC_JWKS_URLS={}
# OIDC_CLIENT_IDS={"auth0":"YOUR_CLIENT_ID","azure":"YOUR_CLIENT_ID"}
OIDC_CLIENT_IDS={}
# OIDC_ISSUERS={"auth0":"https://YOUR_TENANT.auth0.com/","azure":"https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0"}
OIDC_ISSUERS={}
# Email domains allowed to self-identify as clinicians (comma-separated)
CLINICIAN_EMAIL_DOMAINS=

# OpenTelemetry (traces exported to this OTLP/HTTP endpoint)
# Default collector when running docker-compose.observability.yml: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
